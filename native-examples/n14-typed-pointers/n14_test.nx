// Фаза N14 - живий freestanding-тест справжніх типізованих вказівників
// ptr<T>. Пам'ять під тестові буфери виділяє САМ C-гарнес (harness.c,
// звичайні статичні масиви) - тут перевіряється лише сам механізм
// ptr<T> (масштабоване індексування/арифметика/порівняння), без
// залежності від kheap.nx.

func readI32(p: ptr<int32>, i: i32) -> int32 {
    return p[i]
}

func writeI32(p: ptr<int32>, i: i32, v: int32) {
    p[i] = v
}

func readU8(p: ptr<uint8>, i: i32) -> uint8 {
    return p[i]
}

func writeU8(p: ptr<uint8>, i: i32, v: uint8) {
    p[i] = v
}

// Перевіряє, що арифметика "ptr + N" масштабує N на sizeof(T) - для
// ptr<int32> (4 байти) - "p + 1" МАЄ вказувати на p[1], НЕ на p+1 байт.
func sumViaPointerArith(p: ptr<int32>) -> int32 {
    var q = p + 1
    return p[0] + q[0]
}

// Перевіряє те саме для ptr<uint8> (1 байт) - "p + 1" тут ЗБІГАЄТЬСЯ з
// "p + 1 байт" (масштаб 1), на відміну від ptr<int32> вище - разом ці
// дві функції доводять, що масштаб РЕАЛЬНО залежить від T, а не
// завжди "1 байт" (стара String-арифметика) чи завжди "4 байти".
func sumBytesViaPointerArith(p: ptr<uint8>) -> uint8 {
    var q = p + 1
    var a = p[0]
    var b = q[0]
    return a + b
}

func isNullPtr(p: ptr<int32>) {
    if (p == 0) {
        return 1
    }
    return 0
}

func ptrEquality(a: ptr<int32>, b: ptr<int32>) {
    if (a == b) {
        return 1
    }
    return 0
}

// Читання/запис ptr<int16> - третя ширина (окрім 1 і 4 байтів вище),
// доводить, що масштаб/адресація не хардкодена лише під ці дві.
func readI16(p: ptr<int16>, i: i32) -> int16 {
    return p[i]
}

func writeI16(p: ptr<int16>, i: i32, v: int16) {
    p[i] = v
}
