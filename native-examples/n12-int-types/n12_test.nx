// Фаза N12 - живий freestanding-тест справжніх Int32/UInt32.
// Кожна функція - окрема перевірка, викликається C-гарнесом (harness.c)
// через C ABI, БЕЗ жодного зв'язку з NyxOS (лише арифметика).

func addI32(a: int32, b: int32) -> int32 {
    return a + b
}

func addU32(a: uint32, b: uint32) -> uint32 {
    return a + b
}

func divI32(a: int32, b: int32) -> int32 {
    return a / b
}

func divU32(a: uint32, b: uint32) -> uint32 {
    return a / b
}

func ltSignedI32(a: int32, b: int32) {
    if (a < b) {
        return 1
    }
    return 0
}

func ltUnsignedU32(a: uint32, b: uint32) {
    if (a < b) {
        return 1
    }
    return 0
}

func shrI32(a: int32, n: int32) -> int32 {
    return a >> n
}

func shrU32(a: uint32, n: uint32) -> uint32 {
    return a >> n
}

func notI32(a: int32) -> int32 {
    return ~a
}

// Number <-> Int32/UInt32 межа (toI32/toU32/toNumber) - конвертери
// мають бути СИМЕТРИЧНІ: Number -> Int32 -> Number повертає той самий
// double, ЯКЩО значення влазить у знаковий діапазон.
func roundtripSignedViaNumber(x: int32) -> int32 {
    var n = toNumber(x)
    var y = toI32(n)
    return y
}

func roundtripUnsignedViaNumber(x: uint32) -> uint32 {
    var n = toNumber(x)
    var y = toU32(n)
    return y
}

func bitwiseNoConversion(a: int32, b: int32) -> int32 {
    return (a & b) | (a ^ b)
}
