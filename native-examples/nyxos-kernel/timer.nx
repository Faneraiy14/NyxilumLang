// timer.nx — переклад src/timer.c (репозиторій NyxOS) на NyxilumLang,
// --target nyxos-kernel. Сьомий модуль ядра - перший, що РЕЄСТРУЄ себе
// як обробник апаратного переривання (IRQ0 -> isr_register_handler),
// а не лише викликається кимось іншим - той самий примітив "адреса
// функції як значення", що вже дає auth.c/pci.c (Фаза N8.5c),
// застосований тут до iSR-таблиці замість callback'а keyboard/pci_scan.
//
// **ДВІ РЕЧІ, ВАРТІ ОСОБЛИВОЇ УВАГИ (обидві - клас "адреса, не
// число", вже задокументований для pci.c/kheap.c):**
//
// 1. `timer_handler(regs) -> scheduler_tick(regs) -> isr.s` - ВЕСЬ цей
//    ланцюжок передає й повертає СИРУ адресу стека (ESP), НЕ число.
//    `scheduler_tick` (зовнішня, з process.c) додана в
//    ExternalKernelReturnTypes компілятора як String (як і kmalloc) -
//    БЕЗ цього її 4-байтовий результат (справжня адреса стека)
//    пройшов би крізь `cvtsi2sd` (int->double) за замовчуванням для
//    "невідомих" зовнішніх функцій і був би СПОТВОРЕНИЙ на біт-рівні,
//    isr.s підставив би сміттєву адресу замість справжнього стека
//    наступного процесу - миттєвий крах ядра. `timer_handler` сам
//    оголошений `-> string` з тієї самої причини (isr.s читає
//    сирий %eax як нову адресу ESP, не double).
// 2. `divisor = PIT_BASE_FREQUENCY / frequency_hz` (ціле ділення в C)
//    НЕ потребує окремого трюку truncation - `&`/`>>` нижче (побітові
//    оператори Фази N8) уже САМІ роблять cvttsd2si (обрізання до
//    цілого) як ПЕРШИЙ крок, перш ніж застосувати маску/зсув - тобто
//    дробова частина divisor однаково відкидається природно, коли ми
//    беремо divisor & 255 / (divisor >> 8) & 255 для порту.
//    `timer_sleep_ms`, навпаки, порівнює `target_ticks` через `<`
//    (НЕ побітову операцію) - порівняння НЕ обрізає автоматично, тому
//    тут довелось явно відтворити С-подібне ціле ділення формулою
//    (a - a%b) / b (== trunc(a/b), той самий трюк, що компілятор сам
//    використовує для `%` внутрішньо) - без цього ціль спала б РІВНО
//    на 1 тік довше на неточних ms (напр. 15мс -> 3 тіки замість 2) -
//    не крах, але помітна, невиправдана розбіжність з оригіналом.

var ticks = 0

func timer_handler(regs: string) -> string {
    ticks = ticks + 1
    return scheduler_tick(regs)
}

func timer_init(frequency_hz: i32) {
    var divisor = 1193182 / frequency_hz

    outb(67, 54)  // PIT_COMMAND=0x43, канал 0/lobyte-hibyte/режим 3/двійковий = 0x36
    outb(64, divisor & 255)         // PIT_CHANNEL0=0x40, молодший байт
    outb(64, (divisor >> 8) & 255)  // старший байт

    isr_register_handler(32, timer_handler) // IRQ0 -> вектор 32
}

func timer_get_ticks() -> i32 {
    return ticks
}

func timer_sleep_ms(ms: i32) {
    var numerator = ms + 9
    var target_ticks = (numerator - numerator % 10) / 10 // цілочисельне ділення - дивись примітку 2 зверху файлу
    if target_ticks == 0 {
        target_ticks = 1
    }
    var start = ticks
    while (ticks - start) < target_ticks {
        // зайнятий цикл - навмисно порожній, як в оригіналі
    }
}
