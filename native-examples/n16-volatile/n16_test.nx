// Фаза N16 - живий тест "var volatile" - самодокументація/майбутня
// страховка, НАРАЗІ семантично no-op (компілятор і так не переупорядковує
// й не кешує пам'ять - жодної оптимізації такого роду немає взагалі).
// Доводимо: (1) парситься й компілюється коректно і для глобальних, і
// для локальних; (2) функціонально працює як звичайна змінна;
// (3) байтово ІДЕНТИЧНИЙ асемблер з volatile і без нього (n16_test_novol.nx)
// - реальний доказ "справді no-op зараз", не голослівне твердження.

var volatile hwStatusReg: int32;

func readStatus() -> int32 {
    return hwStatusReg
}

func writeStatus(v: int32) {
    hwStatusReg = v
}

func localVolatileRoundtrip(x: int32) -> int32 {
    var volatile local = x
    return local
}
