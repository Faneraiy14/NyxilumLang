// ChaCha20 (RFC 8439) + cryptoSeal/cryptoOpen + secureRandomBytes.
// Еталони: вектор RFC 8439 §2.4.2 і випадковий 200-байтний (4 блоки,
// лічильник 7), обидва згенеровані openssl enc -chacha20.
import "../lib/testing.nx" { assertEqual, assertTrue }
import "../lib/bytes.nx"
import "../lib/crypto.nx"

func main() {
    var key = []
    var i = 0
    while i < 32 {
        append(key, i)
        i = i + 1
    }
    var plain = asciiBytes("Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.")
    var nonce = hexToBytes("000000000000004a00000000")
    assertEqual(bytesToHex(chacha20(key, nonce, 1, plain)), "6e2e359a2568f98041ba0728dd0d6981e97e7aec1d4360c20a27afccfd9fae0bf91b65c5524733ab8f593dabcd62b3571639d624e65152ab8f530c359f0861d807ca0dbf500d6a6156a38e088a22b65e52bc514d16ccf806818ce91ab77937365af90bbf74a35be6b40b8eedf2785e42874d", "chacha20 RFC 8439 2.4.2")
    assertEqual(bytesToHex(chacha20(key, nonce, 1, chacha20(key, nonce, 1, plain))), bytesToHex(plain), "chacha20 туди-назад")
    var k2 = hexToBytes("fbd2dc69c3f062cf6aeb9bb8f3f2e786187a3f50a20394b05474ad7499c7a880")
    var n2 = hexToBytes("54e86441a8670ae3b827b3f6")
    var d2 = hexToBytes("")
    assertEqual(bytesToHex(chacha20(k2, n2, 7, d2)), "", "chacha20 200 Б, лічильник 7 (openssl)")
    assertEqual(len(chacha20(k2, n2, 1, [])), 0, "порожні дані")

    // secureRandomBytes
    var r1 = secureRandomBytes(32)
    var r2 = secureRandomBytes(32)
    assertEqual(len(r1), 32, "secureRandomBytes довжина")
    assertTrue(bytesToHex(r1) != bytesToHex(r2), "secureRandomBytes різні")
    var inRange = true
    i = 0
    while i < 32 {
        if r1[i] < 0 || r1[i] > 255 || r1[i] != floor(r1[i]) {
            inRange = false
        }
        i = i + 1
    }
    assertTrue(inRange, "secureRandomBytes байти 0..255")

    // шифрування з перевіркою
    var enc = secureRandomBytes(32)
    var mac = secureRandomBytes(32)
    var sealed = cryptoSeal(enc, mac, utf8Encode("пароль від FTP: s3cr3t ✅"))
    assertEqual(len(sealed), 12 + len(utf8Encode("пароль від FTP: s3cr3t ✅")) + 32, "розмір: nonce+шифр+тег")
    assertEqual(utf8Decode(cryptoOpen(enc, mac, sealed)), "пароль від FTP: s3cr3t ✅", "seal -> open")
    var bad = slice(sealed, 0, len(sealed))
    bad[15] = bad[15] ^ 1
    assertTrue(isNull(cryptoOpen(enc, mac, bad)), "змінений байт шифру -> null")
    var badTag = slice(sealed, 0, len(sealed))
    badTag[len(badTag) - 1] = badTag[len(badTag) - 1] ^ 128
    assertTrue(isNull(cryptoOpen(enc, mac, badTag)), "змінений тег -> null")
    assertTrue(isNull(cryptoOpen(enc, secureRandomBytes(32), sealed)), "чужий ключ MAC -> null")
    assertTrue(isNull(cryptoOpen(enc, mac, [1, 2, 3])), "сміття -> null")
    assertTrue(bytesToHex(cryptoSeal(enc, mac, asciiBytes("x"))) != bytesToHex(cryptoSeal(enc, mac, asciiBytes("x"))), "той самий текст - різний шифр (новий nonce)")
    var t = cryptoSealText(enc, mac, "логін: sviat")
    assertEqual(cryptoOpenText(enc, mac, t), "логін: sviat", "текст туди-назад")
    assertTrue(isNull(cryptoOpenText(enc, mac, "не base64 !!!")), "не base64 -> null")
    // pbkdf2Native = pbkdf2Sha256 на .nx (і вектор RFC 7914 §11: P="passwd", S="salt", c=1)
    assertEqual(bytesToHex(pbkdf2Native(asciiBytes("passwd"), asciiBytes("salt"), 1, 64)), "55ac046e56e3089fec1691c22544b605f94185216dde0465e68b9d57c20dacbc49ca9cccf179b645991664b39d77ef317c71b845b1e30bd509112041d3a19783", "pbkdf2Native RFC 7914")
    var pw = utf8Encode("майстер-пароль 🔐")
    var salt = secureRandomBytes(16)
    assertEqual(bytesToHex(pbkdf2Native(pw, salt, 300, 64)), bytesToHex(pbkdf2Sha256(pw, salt, 300, 64)), "pbkdf2Native == pbkdf2Sha256 (.nx), 300 ітерацій, 64 Б")
    var t0 = timestamp()
    pbkdf2Native(pw, salt, 600000, 32)
    assertTrue(timestamp() - t0 < 5, "600000 ітерацій нативно - швидко")
    print("OK ChaCha20 + seal/open + secureRandomBytes + pbkdf2Native")
}
