// Велика програма: байткод > 64 КБ. Операнди інструкцій колись були
// 16-бітні - адреси переходів і викликів за межею "загорталися", і VM
// стрибала в довільне місце (знайдено на боті Маяк, 30.09.2026).
// filler() - 8000 рядків, далі функції з циклами, переходами й викликами.
func check(name, got, expected) {
    if got != expected {
        throw name + ": очікувалось " + toString(expected) + ", отримано " + toString(got)
    }
    print("OK " + name)
}

