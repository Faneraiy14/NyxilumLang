func late(a) {
    var sum = 0
    var i = 0
    while true {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > a {
            break
        }
        sum = sum + i
    }
    try {
        throw "далеко"
    } catch (e) {
        return [sum, e]
    }
}

func main() {
    check("8000 рядків коду", filler(), 8000)
    var r = late(9)
    check("цикл після 64 КБ", r[0], 25)
    check("try/catch після 64 КБ", r[1], "далеко")
    var f = func(n) { return n * 2 }
    check("замикання після 64 КБ", f(21), 42)
    print("Велика програма відпрацювала")
}
