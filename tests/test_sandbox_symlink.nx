// Пісочниця (NX_SANDBOX=1) перевіряла лише ЛЕКСИЧНИЙ шлях
// (Path.GetFullPath - нормалізація "."/".."), не символічне посилання на
// диску: файл "escape_link.txt" усередині робочої директорії, що
// насправді symlink на файл ЗА її межами, читався безперешкодно - живцем
// перевірено на /etc/passwd. Сам цей .nx-файл нічого не готує (симлінк
// створює й прибирає run_all.sh навколо виклику), запускається лише з
// NX_SANDBOX=1.
func main() {
    try {
        print(readFile("escape_link.txt"))
        print("ПРОВАЛ: пісочниця не завадила прочитати symlink назовні")
    } catch (e) {
        print("Спіймано: OK")
    }
}

main()
