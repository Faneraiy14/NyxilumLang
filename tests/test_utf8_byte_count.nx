// len(s) рахує .NET string.Length (UTF-16 code units), НЕ байти - для
// кирилиці/емодзі це майже вдвічі менше за реальний розмір, яким рядок
// ляже на диск (усе зберігається як UTF-8). Живий приклад: nyxilum-paste
// приймав 400КБ кирилиці при заявленому ліміті 200КБ, бо перевіряв
// len(text) замість реального розміру в байтах.

func main() {
    if (utf8ByteCount("abcd") != 4) {
        throw "ASCII: 4 символи мали дати 4 байти"
    }
    if (utf8ByteCount("аааа") != 8) {
        throw "кирилиця: 4 символи (по 2 байти UTF-8 кожен) мали дати 8 байтів"
    }
    if (utf8ByteCount("") != 0) {
        throw "порожній рядок мав дати 0 байтів"
    }
    if (utf8ByteCount("a") == utf8ByteCount("а")) {
        throw "латинська 'a' (1 байт) і кирилична 'а' (2 байти) не мають збігатись"
    }

    print("utf8_byte_count: OK")
}

main()
