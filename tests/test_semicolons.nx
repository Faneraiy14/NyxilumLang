// ';' - опційний роздільник операторів (як у C/JS/PHP). Лексер завжди
// визнавав ';' як Punctuation, але жодне правило парсера його не
// споживало: "var x = 1; print(x)" в один рядок падало з непов'язаною
// помилкою "Невідомий вираз" замість того, щоб просто розділити два
// оператори.
func main() {
    print("=== кілька операторів через ; на одному рядку ===")
    var a = 1; var b = 2; print(a + b)

    print("=== кілька ';' підряд (порожні оператори) ===")
    var c = 5;;; print(c)

    print("=== зайвий ';' в кінці оператора ===")
    print("ок");

    print("\n✅ Тест ';' завершено")
}

main()
