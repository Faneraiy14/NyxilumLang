// Побітові оператори (Фаза N8, 16.09.2026) - перевірено живцем ОБОМА
// шляхами (VM тут, native через compile-native --target linux, окремо,
// побайтова звірка - NATIVE_ROADMAP.md) на ТИХ САМИХ значеннях.
import "../lib/testing.nx" { assertEqual }

func main() {
    assertEqual(5 & 3, 1, "5 & 3 = 1")
    assertEqual(5 | 3, 7, "5 | 3 = 7")
    assertEqual(5 ^ 3, 6, "5 ^ 3 = 6")
    assertEqual(15 & 9, 9, "15 & 9 = 9")
    assertEqual(12 | 3, 15, "12 | 3 = 15")
    assertEqual(1 << 4, 16, "1 << 4 = 16")
    assertEqual(256 >> 4, 16, "256 >> 4 = 16")
    assertEqual(~0, -1, "~0 = -1")
    assertEqual(~5, -6, "~5 = -6")

    // Пріоритет: << і >> слабші за + і -, але щільніші за порівняння,
    // & щільніший за ==, | слабший за &.
    assertEqual(2 + 3 << 1, 10, "(2+3)<<1 = 10 - зсув слабший за +")
    assertEqual(1 << 2 + 3, 32, "1<<(2+3) = 32 - те саме з іншого боку")
    assertEqual(6 & 5 == 4, 0, "6 & (5==4) = 6 & 0 = 0 - & слабший за ==")

    // Арифметична (зі знаком) природа >> - НЕ логічний зсув.
    assertEqual(-8 >> 1, -4, ">> зберігає знак (арифметичний зсув)")

    print("Усі перевірки побітових операторів пройдено.")
}
