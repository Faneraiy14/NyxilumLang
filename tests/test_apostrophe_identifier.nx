// Апостроф - законна частина українського письма всередині ідентифікатора
// (ім'я, об'єкт, п'ять), а не рядковий роздільник. Раніше лексер його
// взагалі не розпізнавав ("Невідомий символ '''"), хоча ідентифікатори
// вже й так підтримують кирилицю.
import "../lib/testing.nx" { assertEqual }

func main() {
    var ім'я = "Вася"
    assertEqual(ім'я, "Вася", "ідентифікатор з апострофом читається")

    var об'єкт = 42
    assertEqual(об'єкт, 42, "апостроф всередині іншого ідентифікатора теж")

    // Апостроф у РЯДКУ (не ідентифікаторі) не мав зламатись фіксом.
    var текст = "рядок з апострофом: don't stop"
    assertEqual(текст, "рядок з апострофом: don't stop", "апостроф у рядковому літералі не займає")

    print("усі перевірки пройдено")
}
