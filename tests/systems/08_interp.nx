// S4: міні-інтерпретатор стекового байткоду (як серце JVM): if-ланцюжок по коду інструкції
// компілюється в таблицю переходів. Програма: сума (i*i) % 7 для i < N, плюс перевірка гілок.
func run(code: ptr<int32>, n: int64) -> int64 {
    var stack: [int64; 64]
    var regs: [int64; 8]
    regs[1] = n
    var sp: int64 = 0
    var pc: int64 = 0
    while true {
        var op = code[pc]
        pc = pc + 1
        if op == 0 {
            return stack[sp - 1]
        } else if op == 1 {
            stack[sp] = int64(code[pc])
            pc = pc + 1
            sp = sp + 1
        } else if op == 2 {
            stack[sp] = regs[code[pc]]
            pc = pc + 1
            sp = sp + 1
        } else if op == 3 {
            sp = sp - 1
            regs[code[pc]] = stack[sp]
            pc = pc + 1
        } else if op == 4 {
            sp = sp - 1
            stack[sp - 1] = stack[sp - 1] + stack[sp]
        } else if op == 5 {
            sp = sp - 1
            stack[sp - 1] = stack[sp - 1] - stack[sp]
        } else if op == 6 {
            sp = sp - 1
            stack[sp - 1] = stack[sp - 1] * stack[sp]
        } else if op == 7 {
            sp = sp - 1
            stack[sp - 1] = stack[sp - 1] % stack[sp]
        } else if op == 8 {
            sp = sp - 1
            if stack[sp - 1] < stack[sp] {
                stack[sp - 1] = 1
            } else {
                stack[sp - 1] = 0
            }
        } else if op == 9 {
            sp = sp - 1
            if stack[sp] == 0 {
                pc = int64(code[pc])
            } else {
                pc = pc + 1
            }
        } else if op == 10 {
            pc = int64(code[pc])
        } else if op == 11 {
            stack[sp] = stack[sp - 1]
            sp = sp + 1
        } else if op == 12 {
            regs[code[pc]] = regs[code[pc]] + 1
            pc = pc + 1
        } else {
            return -1
        }
    }
    return 0
}

func main() {
    // r0 = i, r1 = N, r2 = sum
    // 0: LOAD 0, LOAD 1, LT, JZ 25, LOAD 0, DUP, MUL, PUSH 7, MOD, LOAD 2, ADD, STORE 2, INC 0, JMP 0, 25: LOAD 2, HALT
    var c: ptr<int32> = alloc(64 * 4)
    c[0] = 2
    c[1] = 0
    c[2] = 2
    c[3] = 1
    c[4] = 8
    c[5] = 9
    c[6] = 24
    c[7] = 2
    c[8] = 0
    c[9] = 11
    c[10] = 6
    c[11] = 1
    c[12] = 7
    c[13] = 7
    c[14] = 2
    c[15] = 2
    c[16] = 4
    c[17] = 3
    c[18] = 2
    c[19] = 12
    c[20] = 0
    c[21] = 10
    c[22] = 0
    c[23] = 0
    c[24] = 2
    c[25] = 2
    c[26] = 0
    print(run(c, 1000))
    print(run(c, 3000000))
    c[0] = 99
    print(run(c, 10))
}
