// S4: таблиця переходів - від'ємні, беззнакові, пропуски, без else, повтор (лишається ланцюжком)
func neg(x: int8) -> int64 {
    if x == -3 {
        return 30
    } else if x == -1 {
        return 10
    } else if x == 0 {
        return 0
    } else if x == 2 {
        return 20
    } else if x == 127 {
        return 1270
    } else {
        return 999
    }
}

func uns(x: uint64) -> int64 {
    var r: int64 = 5
    if x == 18446744073709551615 {
        r = 1
    } else if x == 18446744073709551614 {
        r = 2
    } else if x == 18446744073709551613 {
        r = 3
    } else if x == 18446744073709551612 {
        r = 4
    }
    return r
}

func main() {
    for i in -4..4 {
        put(neg(int8(i)))
        put(" ")
    }
    print(neg(127))
    print(uns(18446744073709551615))
    print(uns(18446744073709551612))
    print(uns(0))
}
