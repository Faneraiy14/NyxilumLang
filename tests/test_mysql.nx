// lib/mysql.nx проти справжнього MySQL/MariaDB. Без NX_TEST_MYSQL_URL -
// пропуск (у CI задається service-контейнером).
import "../lib/testing.nx" { assertEqual, assertTrue }
import "../lib/mysql.nx"

func main() {
    var url = osEnv("NX_TEST_MYSQL_URL")
    if url == "" {
        print("NX_TEST_MYSQL_URL не задано - тест MySQL пропущено")
        return null
    }
    var db = mysqlConnect(url)
    mysqlExec(db, "DROP TABLE IF EXISTS nx_test_notes", [])
    mysqlExec(db, "CREATE TABLE nx_test_notes (id INT AUTO_INCREMENT PRIMARY KEY, title VARCHAR(100), n INT, big BIGINT, price DECIMAL(10,2), f DOUBLE, created DATETIME, note TEXT) CHARACTER SET utf8mb4", [])
    assertEqual(mysqlInsert(db, "INSERT INTO nx_test_notes(title, n, big, price, f, created, note) VALUES (?, ?, ?, ?, ?, ?, ?)", ["Привіт 🗼", 42, -9007199254740991, 3.5, 2.25, "2026-09-30 11:22:33", null]), 1, "insertId 1")
    mysqlInsert(db, "INSERT INTO nx_test_notes(title, n, big, price, f, created, note) VALUES (?, ?, ?, ?, ?, ?, ?)", ["'; DROP TABLE nx_test_notes; --", -7, 0, 0, -0.5, "2000-01-01 00:00:00", "O'Reilly"])
    var rows = mysqlQuery(db, "SELECT * FROM nx_test_notes WHERE n > ? ORDER BY id", [-100])
    assertEqual(len(rows), 2, "2 рядки (prepared)")
    assertEqual(mapGet(rows[0], "title"), "Привіт 🗼", "кирилиця/емодзі")
    assertEqual(mapGet(rows[0], "big"), -9007199254740991, "BIGINT на межі 2^53")
    assertEqual(mapGet(rows[0], "price"), 3.5, "DECIMAL")
    assertEqual(mapGet(rows[0], "f"), 2.25, "DOUBLE")
    assertEqual(mapGet(rows[0], "created"), "2026-09-30 11:22:33", "DATETIME")
    assertEqual(mapGet(rows[1], "created"), "2000-01-01 00:00:00", "DATETIME з нульовим часом")
    assertTrue(isNull(mapGet(rows[0], "note")), "NULL")
    assertEqual(mapGet(rows[1], "title"), "'; DROP TABLE nx_test_notes; --", "ін'єкція лишилась даними")
    var text = mysqlQuery(db, "SELECT id, title, price, note FROM nx_test_notes ORDER BY id", [])
    assertEqual(mapGet(text[1], "note"), "O'Reilly", "текстовий протокол")
    assertEqual(mysqlExec(db, "UPDATE nx_test_notes SET n = n + 1 WHERE id >= ?", [1]), 2, "UPDATE")
    var failed = false
    try {
        mysqlQuery(db, "SELECT * FROM nx_no_such_table", [])
    } catch (e) {
        failed = true
    }
    assertTrue(failed, "помилка SQL -> виняток")
    assertEqual(mapGet(mysqlQuery(db, "SELECT 1 + ? AS x", [1])[0], "x"), 2, "з'єднання живе після помилки")
    mysqlExec(db, "DROP TABLE nx_test_notes", [])
    mysqlClose(db)
    print("Усі перевірки MySQL пройдено")
}
