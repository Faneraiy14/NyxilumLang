// Жорсткіші випадки: рекурсія, від'ємні/дробові, побітові, % від'ємних,
// throw з глибини викликів, багато локальних змінних (далекі слоти кадру)
func fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func deep(n) {
    if n == 0 {
        throw 42
    }
    return deep(n - 1) + 1
}

func many() {
    var a0 = 0
    var a1 = 1
    var a2 = 2
    var a3 = 3
    var a4 = 4
    var a5 = 5
    var a6 = 6
    var a7 = 7
    var a8 = 8
    var a9 = 9
    var b0 = 10
    var b1 = 11
    var b2 = 12
    var b3 = 13
    var b4 = 14
    var b5 = 15
    var b6 = 16
    var b7 = 17
    var b8 = 18
    var b9 = 19
    var c0 = 20
    var c1 = 21
    var c2 = 22
    var c3 = 23
    var c4 = 24
    var c5 = 25
    var c6 = 26
    var c7 = 27
    var c8 = 28
    var c9 = 29
    var d0 = 30
    var d1 = 31
    var d2 = 32
    var d3 = 33
    var d4 = 34
    var d5 = 35
    d5 = d5 + a0 + a9 + c9
    return d5 + d0
}

func main() {
    print(fib(20))
    print(-3.25)
    print(0 - 1234567.5)
    print(7 % 3)
    print(0 - 7 % 3)
    print(12 & 10)
    print(12 | 3)
    print(12 ^ 5)
    print(1 << 10)
    print(0 - 16 >> 2)
    print(~5)
    print(many())
    try {
        print(deep(50))
    } catch (e) {
        print(e)
    }
    var i = 0
    var s = 0
    while true {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > 99 {
            break
        }
        s = s + i
    }
    print(s)
    print(1 / 4)
    print(fib(10) == 55 && !(3 > 4))
}
