// targets: arm64
// Читання stdin рядок за рядком (протокол "перекладача" Android)
func main() {
    var n = toInt(readLine())
    var sum = 0
    var i = 0
    while i < n {
        var parts = split(readLine(), "\t")
        print(parts[0] + " -> " + parts[1])
        sum = sum + toDouble(parts[1])
        i = i + 1
    }
    print("сума " + sum)
    print("[" + readLine() + "]")
    print("[" + readLine() + "]")
}
