// targets: arm64
// randomInt(a, b) - ОБИДВІ межі включно (як у VM): за 2000 спроб мають
// випасти і a, і b, і жодного разу нічого поза межами
func main() {
    var seenLo = false
    var seenHi = false
    var bad = 0
    var i = 0
    while i < 2000 {
        var r = randomInt(3, 5)
        if r == 3 { seenLo = true }
        if r == 5 { seenHi = true }
        if r < 3 || r > 5 || floor(r) != r { bad = bad + 1 }
        i = i + 1
    }
    print(seenLo && seenHi && bad == 0)
}
