// Етап 1: if/else, while, break, continue, вкладені цикли
func main() {
    var i = 0
    var sum = 0
    while i < 10 {
        i = i + 1
        if i % 2 == 0 {
            continue
        }
        if i > 7 {
            break
        }
        sum = sum + i
    }
    print(sum)
    var a = 0
    while a < 3 {
        var b = 0
        while b < 2 {
            print(a * 10 + b)
            b = b + 1
        }
        a = a + 1
    }
    if sum > 100 {
        print("великий")
    } else {
        print("малий")
    }
}
