// Етап 2: функції з параметрами, рекурсія
func square(x) {
    return x * x
}

func add3(a, b, c) {
    return a + b + c
}

func fact(n) {
    if n <= 1 {
        return 1
    }
    return n * fact(n - 1)
}

func fib(n) {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

func main() {
    print(square(9))
    print(add3(1, 2, 3.5))
    print(fact(10))
    print(fib(20))
}
