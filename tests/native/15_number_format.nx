// targets: arm64
// Друк чисел: найкоротший точний запис, як у VM (C# double.ToString())
func main() {
    print(0.1)
    print(0.1 + 0.2)
    print(1 / 3)
    print(2 / 3)
    print(-1.5)
    print(123.456)
    print(0.0001)
    print(0.00001)
    print(5 / 100000)
    print(1.5 / 10000000)
    var a = 10000000000.0
    print(a * 1000000)
    print(a * 10000000)
    print(a * a)
    print(1 / 3 * 1000000000000000000000)
    print(123456789012)
    print(999999999999999)
    print(1000000000000000)
    print(-1 * 0)
    print(0 - 0)
    print(1 / 0)
    print(-1 / 0)
    print(0 / 0)
    print(3.14159)
    print(0.3 - 0.1)
    print(100 * 1.1)
    print(1 / 7)
    print(9007199254740993)
    print(0.5)
    print(4.35 * 100)
    print(toString(a * a * a / 7))
}
