// httpServer(port, handler) блокує назавжди (як guiShow), тому не в
// автоматичному прогоні — для ручної перевірки: запустити й у другому
// терміналі curl.
//
// handler отримує ОДИН аргумент — мапу запиту {path, method, body, query,
// headers} — а не (path, method) окремо: дозволяє читати тіло POST-запиту
// (форми, JSON API, вебхуки), чого раніше не можна було зробити взагалі.
// Відповідь — звичайний рядок (статус 200, text/html) або мапа
// {status?, body?, contentType?} для повного контролю.

func handler(req) {
    var path = mapGet(req, "path")
    var method = mapGet(req, "method")
    print("Запит: " + method + " " + path + " (тіло: " + toString(len(mapGet(req, "body"))) + " байт)")

    if path == "/" {
        return "Привіт з NyxilumLang HTTP-сервера!"
    }
    if path == "/echo" && method == "POST" {
        var m = newMap()
        mapSet(m, "status", 200)
        mapSet(m, "body", mapGet(req, "body"))
        mapSet(m, "contentType", "text/plain; charset=utf-8")
        return m
    }
    var notFound = newMap()
    mapSet(notFound, "status", 404)
    mapSet(notFound, "body", "Не знайдено: " + path)
    return notFound
}

func main() {
    httpServer(8765, handler)
}

main()
