// lib/telegram.nx — обгортка над Telegram Bot API (https://core.telegram.org/bots/api).
// API самого Telegram — звичайний HTTPS+JSON, без WebSocket, тож повністю
// реалізується через наявні httpGet/httpPost/toJson/fromJson без жодного
// нового нативного коду. token НІКОЛИ не хардкодь у скрипті — читай через
// osEnv("TELEGRAM_BOT_TOKEN"), як у прикладі programs/telegram_echo_bot.nx.

// Усюди тут httpRequest, НЕ httpGet/httpPost: Telegram повертає корисне
// JSON-тіло помилки навіть на 4xx (напр. {"ok":false,"description":"..."}
// при невірному токені), а httpGet/httpPost кидають виняток на будь-якому
// коду поза 2xx ще ДО того, як тіло можна прочитати - httpRequest тіла
// не втрачає ні на якому статус-коді.

func tgGetMe(token) {
    var res = httpRequest("https://api.telegram.org/bot" + token + "/getMe", "GET", null)
    return fromJson(mapGet(res, "body"))
}

func tgSendMessage(token, chatId, text) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "text", text)
    var url = "https://api.telegram.org/bot" + token + "/sendMessage"
    var res = httpRequest(url, "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// offset - update_id останнього вже обробленого апдейту + 1 (щоб Telegram
// не присилав його вдруге); timeout=30 - long polling: запит "висить" до
// 30с, доки не з'явиться нове повідомлення, замість миттєвого порожнього
// результату (це й відрізняє поллінг від грубого опитування щосекунди).
func tgGetUpdates(token, offset) {
    return tgGetUpdatesWait(token, offset, 30)
}

// Те саме з власною тривалістю long polling (секунди): менше - частіше
// "прокидаємось" для фонових справ (таймери), ціною частіших запитів.
func tgGetUpdatesWait(token, offset, waitSeconds) {
    var url = "https://api.telegram.org/bot" + token + "/getUpdates?offset=" + toString(offset) + "&timeout=" + toString(waitSeconds)
    var res = httpRequest(url, "GET", null)
    var parsed = fromJson(mapGet(res, "body"))
    // ok:false (невалідний/відкликаний токен, 409 через другий запущений
    // екземпляр тощо) - кидаємо, а не повертаємо null: інакше tgPollLoop
    // крутився б без жодної паузи, засипаючи Telegram запитами.
    if !mapGet(parsed, "ok") {
        throw "getUpdates: " + toString(mapGet(parsed, "description"))
    }
    return mapGet(parsed, "result")
}

// message може бути відсутнім в апдейті (напр. edited_message,
// callback_query) - тоді повертає null, а не падає.
func tgMessageText(update) {
    var message = mapGet(update, "message")
    if isNull(message) {
        return null
    }
    return mapGet(message, "text")
}

// id звичайного повідомлення (щоб, напр., видалити його) або null
func tgMessageId(update) {
    var message = mapGet(update, "message")
    if isNull(message) {
        return null
    }
    return mapGet(message, "message_id")
}

// Повідомлення апдейту: нове або відредаговане (трансляція геопозиції
// приходить саме як edited_message) - або null
func tgAnyMessage(update) {
    var message = mapGet(update, "message")
    if isNull(message) {
        message = mapGet(update, "edited_message")
    }
    return message
}

// Для звичайного повідомлення - чат повідомлення; для натискання inline-
// кнопки (callback_query) - чат повідомлення, під яким була кнопка.
func tgChatId(update) {
    var message = tgAnyMessage(update)
    if isNull(message) {
        var cb = mapGet(update, "callback_query")
        if isNull(cb) {
            return null
        }
        message = mapGet(cb, "message")
        if isNull(message) {
            return null
        }
    }
    var chat = mapGet(message, "chat")
    return mapGet(chat, "id")
}

func tgUserId(update) {
    var source = tgAnyMessage(update)
    if isNull(source) {
        source = mapGet(update, "callback_query")
    }
    if isNull(source) {
        return null
    }
    var from = mapGet(source, "from")
    if isNull(from) {
        return null
    }
    return mapGet(from, "id")
}

// Мова Telegram людини (language_code: "uk", "ru", "en-US"...) або null
func tgUserLang(update) {
    var source = tgAnyMessage(update)
    if isNull(source) {
        source = mapGet(update, "callback_query")
    }
    if isNull(source) {
        return null
    }
    var from = mapGet(source, "from")
    if isNull(from) {
        return null
    }
    return mapGet(from, "language_code")
}

// Меню команд бота (кнопка "Меню" в Telegram). commands - масив пар
// [команда без "/", опис]; langCode - "uk"/"ru"/"en"... або null (для всіх
// мов, для яких нема окремого списку). Людина бачить список своєю мовою
// Telegram - замість ручного /setcommands у BotFather.
func tgSetMyCommands(token, commands, langCode) {
    var list = []
    var i = 0
    while i < len(commands) {
        var c = newMap()
        mapSet(c, "command", commands[i][0])
        mapSet(c, "description", commands[i][1])
        append(list, c)
        i = i + 1
    }
    var data = newMap()
    mapSet(data, "commands", list)
    if !isNull(langCode) {
        mapSet(data, "language_code", langCode)
    }
    var res = httpRequest("https://api.telegram.org/bot" + token + "/setMyCommands", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Надіслане місце {latitude, longitude} (звичайне або трансляція) або null
func tgMessageLocation(update) {
    var message = tgAnyMessage(update)
    if isNull(message) {
        return null
    }
    return mapGet(message, "location")
}

// ---------------------------------------------------------------- reply-клавіатура
// Кнопки ПІД полем вводу (не під повідомленням). Єдиний спосіб попросити
// місце розташування: tgLocationButton - Telegram сам спитає людину, чи
// надсилати геопозицію.

func tgLocationButton(text) {
    var b = newMap()
    mapSet(b, "text", text)
    mapSet(b, "request_location", true)
    return b
}

func tgSendMessageWithKeyboard(token, chatId, text, rows) {
    var markup = newMap()
    mapSet(markup, "keyboard", rows)
    mapSet(markup, "resize_keyboard", true)
    mapSet(markup, "one_time_keyboard", true)
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "text", text)
    mapSet(data, "reply_markup", markup)
    var res = httpRequest("https://api.telegram.org/bot" + token + "/sendMessage", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Надіслати повідомлення й прибрати reply-клавіатуру
func tgSendMessageRemoveKeyboard(token, chatId, text) {
    var markup = newMap()
    mapSet(markup, "remove_keyboard", true)
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "text", text)
    mapSet(data, "reply_markup", markup)
    var res = httpRequest("https://api.telegram.org/bot" + token + "/sendMessage", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// ---------------------------------------------------------------- inline-кнопки
// Кнопка під повідомленням: text - що бачить людина, data - рядок до 64
// байт, який бот отримає в callback_query при натисканні.
//   var rows = [[tgButton("💱 Курс", "rate"), tgButton("🔄 Конвертер", "conv")]]
//   tgSendMessageWithButtons(token, chatId, "Що зробимо?", rows)

func tgButton(text, data) {
    var b = newMap()
    mapSet(b, "text", text)
    mapSet(b, "callback_data", data)
    return b
}

// Кнопка-посилання: відкриває url (лише http/https - так вимагає Telegram)
func tgUrlButton(text, url) {
    var b = newMap()
    mapSet(b, "text", text)
    mapSet(b, "url", url)
    return b
}

func tgKeyboard(rows) {
    var markup = newMap()
    mapSet(markup, "inline_keyboard", rows)
    return markup
}

func tgSendMessageWithButtons(token, chatId, text, rows) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "text", text)
    if !isNull(rows) {
        mapSet(data, "reply_markup", tgKeyboard(rows))
    }
    var res = httpRequest("https://api.telegram.org/bot" + token + "/sendMessage", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Замінити текст (і кнопки) вже надісланого повідомлення - так меню
// "перемикається" на місці, а не засипає чат новими повідомленнями.
// Якщо текст і кнопки не змінились, Telegram відповідає ok:false
// ("message is not modified") - це не помилка, результат просто повертається.
func tgEditMessage(token, chatId, messageId, text, rows) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "message_id", messageId)
    mapSet(data, "text", text)
    if !isNull(rows) {
        mapSet(data, "reply_markup", tgKeyboard(rows))
    }
    var res = httpRequest("https://api.telegram.org/bot" + token + "/editMessageText", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Прибрати кнопки з повідомлення (текст лишається) - напр. зі старого
// меню, коли бот уже показав нове
func tgRemoveButtons(token, chatId, messageId) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "message_id", messageId)
    mapSet(data, "reply_markup", tgKeyboard([]))
    var res = httpRequest("https://api.telegram.org/bot" + token + "/editMessageReplyMarkup", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Видалити повідомлення (бот може видаляти свої повідомлення до 48 год)
func tgDeleteMessage(token, chatId, messageId) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "message_id", messageId)
    var res = httpRequest("https://api.telegram.org/bot" + token + "/deleteMessage", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Обов'язкова відповідь на натискання кнопки (інакше в Telegram крутиться
// годинник на кнопці). text - необов'язкове коротке спливаюче повідомлення.
func tgAnswerCallback(token, callbackId, text) {
    var data = newMap()
    mapSet(data, "callback_query_id", callbackId)
    if !isNull(text) {
        mapSet(data, "text", text)
    }
    var res = httpRequest("https://api.telegram.org/bot" + token + "/answerCallbackQuery", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Кнопка "скопіювати": натискання кладе copyText (до 256 символів) у буфер
// обміну, нічого не показуючи в чаті (Bot API 7.11+)
func tgCopyButton(text, copyText) {
    var c = newMap()
    mapSet(c, "text", copyText)
    var b = newMap()
    mapSet(b, "text", text)
    mapSet(b, "copy_text", c)
    return b
}

// Екранування тексту для parse_mode HTML (&, <, >)
func tgHtmlEscape(s) {
    return replace(replace(replace(toString(s), "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
}

// Повідомлення з HTML-розміткою: <b>, <i>, <code>, <tg-spoiler>... Увесь
// "чужий" текст усередині - через tgHtmlEscape.
func tgSendHtml(token, chatId, html, rows) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "text", html)
    mapSet(data, "parse_mode", "HTML")
    if !isNull(rows) {
        mapSet(data, "reply_markup", tgKeyboard(rows))
    }
    var res = httpRequest("https://api.telegram.org/bot" + token + "/sendMessage", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

func tgEditHtml(token, chatId, messageId, html, rows) {
    var data = newMap()
    mapSet(data, "chat_id", chatId)
    mapSet(data, "message_id", messageId)
    mapSet(data, "text", html)
    mapSet(data, "parse_mode", "HTML")
    if !isNull(rows) {
        mapSet(data, "reply_markup", tgKeyboard(rows))
    }
    var res = httpRequest("https://api.telegram.org/bot" + token + "/editMessageText", "POST", toJson(data))
    return fromJson(mapGet(res, "body"))
}

// Надіслати текстовий файл (напр. JSON) як документ - multipart/form-data.
// content - рядок (UTF-8), fileName - як файл називатиметься в чаті.
func tgSendDocument(token, chatId, fileName, content, caption) {
    var boundary = "nxBoundary" + toString(randomInt(100000000, 999999999)) + toString(randomInt(100000000, 999999999))
    var nl = "\r\n"
    var body = "--" + boundary + nl + "Content-Disposition: form-data; name=\"chat_id\"" + nl + nl + toString(chatId) + nl
    if !isNull(caption) {
        body = body + "--" + boundary + nl + "Content-Disposition: form-data; name=\"caption\"" + nl + nl + caption + nl
    }
    body = body + "--" + boundary + nl + "Content-Disposition: form-data; name=\"document\"; filename=\"" + replace(fileName, "\"", "") + "\"" + nl
    body = body + "Content-Type: application/octet-stream" + nl + nl + content + nl + "--" + boundary + "--" + nl
    var headers = newMap()
    mapSet(headers, "Content-Type", "multipart/form-data; boundary=" + boundary)
    var res = httpRequest("https://api.telegram.org/bot" + token + "/sendDocument", "POST", body, headers)
    return fromJson(mapGet(res, "body"))
}

// Документ (файл) з повідомлення: {file_id, file_name, file_size...} або null
func tgMessageDocument(update) {
    var message = tgAnyMessage(update)
    if isNull(message) {
        return null
    }
    return mapGet(message, "document")
}

// Скачати файл, надісланий боту, як текст (до 20 МБ - обмеження Bot API).
// null - не вдалося.
func tgDownloadText(token, fileId) {
    var data = newMap()
    mapSet(data, "file_id", fileId)
    var res = fromJson(mapGet(httpRequest("https://api.telegram.org/bot" + token + "/getFile", "POST", toJson(data)), "body"))
    if !mapGet(res, "ok") {
        return null
    }
    var path = mapGet(mapGet(res, "result"), "file_path")
    var file = httpRequest("https://api.telegram.org/file/bot" + token + "/" + path, "GET", "")
    if mapGet(file, "status") != 200 {
        return null
    }
    return mapGet(file, "body")
}

// callback_query з апдейту або null (апдейт - звичайне повідомлення)
func tgCallback(update) {
    return mapGet(update, "callback_query")
}

func tgCallbackData(update) {
    var cb = tgCallback(update)
    if isNull(cb) {
        return null
    }
    return mapGet(cb, "data")
}

func tgCallbackId(update) {
    var cb = tgCallback(update)
    if isNull(cb) {
        return null
    }
    return mapGet(cb, "id")
}

func tgCallbackMessageId(update) {
    var cb = tgCallback(update)
    if isNull(cb) {
        return null
    }
    var message = mapGet(cb, "message")
    if isNull(message) {
        return null
    }
    return mapGet(message, "message_id")
}

// Блокує назавжди (як httpServer): на кожен новий апдейт викликає
// handler(update) і сам просуває offset - викликач лише обробляє логіку
// одного повідомлення, не думаючи про паги/офсети.
// Два окремі try: збій мережі на getUpdates -> пауза 5с і повтор (бот не
// вмирає, коли пропав інтернет); виняток у handler -> лог і перехід до
// наступного апдейту (offset усе одно просувається, інакше одне "погане"
// повідомлення прилітало б знову й знову і клало бота по колу).
func tgPollLoop(token, handler) {
    tgPollLoopWithTick(token, handler, null)
}

// Те саме + onTick() після кожного циклу getUpdates (не рідше ніж раз на
// ~30 с, бо long polling повертається щонайпізніше через timeout) - для
// фонових справ бота: нагадування, розсилки, прибирання. Виняток в onTick
// логується й не зупиняє бота.
func tgPollLoopWithTick(token, handler, onTick) {
    tgPollLoopWithTickEvery(token, handler, onTick, 30)
}

// + waitSeconds - тривалість long polling: onTick викликається не рідше
// ніж раз на waitSeconds (напр. 5 - для точних таймерів і будильників)
func tgPollLoopWithTickEvery(token, handler, onTick, waitSeconds) {
    var offset = 0
    while true {
        var updates = null
        try {
            updates = tgGetUpdatesWait(token, offset, waitSeconds)
        } catch (e) {
            print("[" + now() + "] getUpdates не вдався: " + toString(e) + " - повтор через 5с")
            sleep(5000)
        }
        if !isNull(updates) {
            var i = 0
            while i < len(updates) {
                var update = updates[i]
                offset = mapGet(update, "update_id") + 1
                try {
                    handler(update)
                } catch (e) {
                    print("[" + now() + "] помилка в обробнику: " + toString(e))
                }
                i = i + 1
            }
        }
        if !isNull(onTick) {
            try {
                onTick()
            } catch (e) {
                print("[" + now() + "] помилка в onTick: " + toString(e))
            }
        }
    }
}
