// lib/collections.nx — утиліти над масивами понад вбудовані sort/mapArr/
// filter/reduce/slice/unique (у дусі Python itertools / lodash).

func range(n) {
    var result = []
    var i = 0
    while i < n {
        append(result, i)
        i = i + 1
    }
    return result
}

func rangeFrom(start, end) {
    var result = []
    var i = start
    while i < end {
        append(result, i)
        i = i + 1
    }
    return result
}

func sum(arr) {
    var total = 0
    var i = 0
    while i < len(arr) {
        total = total + arr[i]
        i = i + 1
    }
    return total
}

func first(arr) {
    if len(arr) == 0 {
        throw "first(): масив порожній"
    }
    return arr[0]
}

func last(arr) {
    if len(arr) == 0 {
        throw "last(): масив порожній"
    }
    return arr[len(arr) - 1]
}

// Розгортає лише ОДИН рівень вкладеності: flatten([1, [2, 3], 4]) -> [1,2,3,4],
// але flatten([1, [2, [3]]]) -> [1, 2, [3]] (внутрішній масив лишається).
func flatten(arr) {
    var result = []
    var i = 0
    while i < len(arr) {
        var item = arr[i]
        if isArray(item) {
            var j = 0
            while j < len(item) {
                append(result, item[j])
                j = j + 1
            }
        } else {
            append(result, item)
        }
        i = i + 1
    }
    return result
}

// Довжина результату = коротший з двох масивів (як Python zip, не padding).
func zip(arr1, arr2) {
    var result = []
    var n = min(len(arr1), len(arr2))
    var i = 0
    while i < n {
        append(result, [arr1[i], arr2[i]])
        i = i + 1
    }
    return result
}

func chunk(arr, size) {
    var result = []
    var i = 0
    while i < len(arr) {
        append(result, slice(arr, i, min(i + size, len(arr))))
        i = i + size
    }
    return result
}

// fn(item) -> bool; рахує елементи, для яких fn повернула true.
func count(arr, fn) {
    var total = 0
    var i = 0
    while i < len(arr) {
        if fn(arr[i]) {
            total = total + 1
        }
        i = i + 1
    }
    return total
}

// fn(item) -> bool; перший елемент, для якого fn повернула true, або null,
// якщо жоден не підійшов (на відміну від first(), яка кидає на порожньому
// масиві - тут "нічого не знайдено" це нормальний, а не винятковий випадок).
func find(arr, fn) {
    var i = 0
    while i < len(arr) {
        if fn(arr[i]) {
            return arr[i]
        }
        i = i + 1
    }
    return null
}

// Той самий пошук, що й find(), але повертає ІНДЕКС (-1, якщо не знайдено) -
// потрібно, коли після пошуку треба саме місце в масиві (наприклад для
// removeAt), а не сам елемент.
func findIndex(arr, fn) {
    var i = 0
    while i < len(arr) {
        if fn(arr[i]) {
            return i
        }
        i = i + 1
    }
    return -1
}

// fn(item) -> bool; true, лише якщо ВСІ елементи задовольняють fn (як
// Python all() / lodash every) - порожній масив дає true (вакуумна істина,
// той самий принцип, що й математичне "для всіх x з порожньої множини").
func every(arr, fn) {
    var i = 0
    while i < len(arr) {
        if !fn(arr[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

// fn(item) -> bool; true, якщо БУДЬ-ЯКИЙ елемент задовольняє fn (як Python
// any() / lodash some) - порожній масив дає false.
func some(arr, fn) {
    var i = 0
    while i < len(arr) {
        if fn(arr[i]) {
            return true
        }
        i = i + 1
    }
    return false
}
