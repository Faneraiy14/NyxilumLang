// Прелюдія системного бекенда x86-64 (NativeCodegenX64) - написана на самій
// NyxilumLang у системному режимі: друк значень і alloc. Компілюється разом
// із кожною програмою. Без libc: лише syscall (write 1, mmap 9).

var __nx_heap: ptr<uint8> = null
var __nx_heap_end: ptr<uint8> = null

func __nx_write(p: ptr<uint8>, n: int64) {
    var done: int64 = 0
    while done < n {
        var r = syscall(1, 1, p + done, n - done)
        if r <= 0 {
            return
        }
        done = done + r
    }
}

func __nx_print_nl() {
    var b = stackbuf(16)
    b[0] = 10
    __nx_write(b, 1)
}

func __nx_print_str(s: ptr<uint8>) {
    var n: int64 = 0
    while s[n] != 0 {
        n = n + 1
    }
    __nx_write(s, n)
}

func __nx_print_u64(v: uint64) {
    var buf = stackbuf(32)
    var i: int64 = 32
    while true {
        i = i - 1
        buf[i] = uint8(v % 10 + 48)
        v = v / 10
        if v == 0 {
            break
        }
    }
    __nx_write(buf + i, 32 - i)
}

func __nx_print_i64(v: int64) {
    if v < 0 {
        __nx_print_str("-")
        __nx_print_u64(uint64(0 - v))
        return
    }
    __nx_print_u64(uint64(v))
}

func __nx_print_bool(b: bool) {
    if b {
        __nx_print_str("True")
    } else {
        __nx_print_str("False")
    }
}

// ---------- дробові: найкоротший запис, що читається назад у те саме число ----------
// Алгоритм Burger & Dybvig (1996), як і в ARM64-прелюдії й C#/VM: 0.1, 1/3 -> 0.3333333333333333,
// 0.1 + 0.2 -> 0.30000000000000004. Великі числа - у масивах цифр по основі 10^7 на стеку
// (без купи): довжина в [0], цифри [1..64].

func __big_set(a: ptr<int64>, v: int64) {
    var n: int64 = 0
    while v > 0 {
        n = n + 1
        a[n] = v % 10000000
        v = v / 10000000
    }
    a[0] = n
}

func __big_copy(d: ptr<int64>, s: ptr<int64>) {
    for i in 0..s[0] + 1 {
        d[i] = s[i]
    }
}

func __big_mul(a: ptr<int64>, m: int64) {
    var carry: int64 = 0
    var n = a[0]
    for i in 1..n + 1 {
        var t = a[i] * m + carry
        a[i] = t % 10000000
        carry = t / 10000000
    }
    while carry > 0 {
        n = n + 1
        a[n] = carry % 10000000
        carry = carry / 10000000
    }
    a[0] = n
}

func __big_mulpow2(a: ptr<int64>, e: int64) {
    while e >= 20 {
        __big_mul(a, 1048576)
        e = e - 20
    }
    __big_mul(a, 1 << e)
}

func __big_mulpow10(a: ptr<int64>, e: int64) {
    while e >= 7 {
        __big_mul(a, 10000000)
        e = e - 7
    }
    var p: int64 = 1
    while e > 0 {
        p = p * 10
        e = e - 1
    }
    __big_mul(a, p)
}

// d = a + b (d може бути тим самим, що a)
func __big_add(d: ptr<int64>, a: ptr<int64>, b: ptr<int64>) {
    var n = a[0]
    if b[0] > n {
        n = b[0]
    }
    var carry: int64 = 0
    for i in 1..n + 1 {
        var t = carry
        if i <= a[0] {
            t = t + a[i]
        }
        if i <= b[0] {
            t = t + b[i]
        }
        if t >= 10000000 {
            d[i] = t - 10000000
            carry = 1
        } else {
            d[i] = t
            carry = 0
        }
    }
    if carry > 0 {
        n = n + 1
        d[n] = carry
    }
    d[0] = n
}

// a = a - b, де a >= b
func __big_sub(a: ptr<int64>, b: ptr<int64>) {
    var borrow: int64 = 0
    for i in 1..a[0] + 1 {
        var t = a[i] - borrow
        if i <= b[0] {
            t = t - b[i]
        }
        if t < 0 {
            a[i] = t + 10000000
            borrow = 1
        } else {
            a[i] = t
            borrow = 0
        }
    }
    while a[0] > 0 && a[a[0]] == 0 {
        a[0] = a[0] - 1
    }
}

func __big_cmp(a: ptr<int64>, b: ptr<int64>) -> int64 {
    if a[0] != b[0] {
        return a[0] - b[0]
    }
    var i = a[0]
    while i >= 1 {
        if a[i] != b[i] {
            return a[i] - b[i]
        }
        i = i - 1
    }
    return 0
}

func __bd_reach(x: ptr<int64>, s: ptr<int64>, inclusive: bool) -> bool {
    var c = __big_cmp(x, s)
    if inclusive {
        return c >= 0
    }
    return c > 0
}

// цифри 0.d1d2... * 10^k -> текст за правилами C#/VM: звичайний запис для -3 <= k <= 17, інакше 1E+18, 5E-05
func __nx_fmt_digits(dg: ptr<uint8>, n: int64, k: int64) {
    var o = stackbuf(64)
    var p: int64 = 0
    if k > 17 || k < -3 {
        o[p] = dg[0] + 48
        p = p + 1
        if n > 1 {
            o[p] = 46
            p = p + 1
            for i in 1..n {
                o[p] = dg[i] + 48
                p = p + 1
            }
        }
        o[p] = 69
        p = p + 1
        var ee = k - 1
        if ee < 0 {
            o[p] = 45
            ee = 0 - ee
        } else {
            o[p] = 43
        }
        p = p + 1
        if ee >= 100 {
            o[p] = uint8(ee / 100 + 48)
            p = p + 1
        }
        o[p] = uint8(ee / 10 % 10 + 48)
        o[p + 1] = uint8(ee % 10 + 48)
        p = p + 2
    } else if k <= 0 {
        o[0] = 48
        o[1] = 46
        p = 2
        for i in 0..0 - k {
            o[p] = 48
            p = p + 1
        }
        for i in 0..n {
            o[p] = dg[i] + 48
            p = p + 1
        }
    } else if k < n {
        for i in 0..n {
            if i == k {
                o[p] = 46
                p = p + 1
            }
            o[p] = dg[i] + 48
            p = p + 1
        }
    } else {
        for i in 0..n {
            o[p] = dg[i] + 48
            p = p + 1
        }
        for i in n..k {
            o[p] = 48
            p = p + 1
        }
    }
    __nx_write(o, p)
}

// bits - біти числа (float64: mb=52, eb=11; float32: mb=23, eb=8)
func __nx_print_fp(bits: int64, mb: int64, eb: int64) {
    var exmask = (1 << eb) - 1
    var ex = (bits >> mb) & exmask
    var f = bits & ((1 << mb) - 1)
    var neg = ((bits >> (mb + eb)) & 1) == 1
    if ex == exmask {
        if f != 0 {
            __nx_print_str("NaN")
            return
        }
        if neg {
            __nx_print_str("-")
        }
        __nx_print_str("Infinity")
        return
    }
    if neg {
        __nx_print_str("-")
    }
    if ex == 0 && f == 0 {
        __nx_print_str("0")
        return
    }
    var bias = (1 << (eb - 1)) - 1
    var hidden = 1 << mb
    var e = 1 - bias - mb
    if ex > 0 {
        f = f + hidden
        e = ex - bias - mb
    }
    // цілі до 10^15 - швидко (лише float64: у float32 точність ~7 цифр, ціле там - не найкоротший запис)
    if mb == 52 && e >= 0 && e <= 10 {
        var v = f << e
        if v < 1000000000000000 {
            __nx_print_u64(uint64(v))
            return
        }
    }
    if mb == 52 && e < 0 && e > -60 {
        if (f & ((1 << (0 - e)) - 1)) == 0 {
            __nx_print_u64(uint64(f >> (0 - e)))
            return
        }
    }
    var st: ptr<int64> = asptr(stackbuf(3200))
    var r = st
    var s = st + 65
    var mp = st + 130
    var mm = st + 195
    var t1 = st + 260
    var t2 = st + 325
    var even = f % 2 == 0
    if e >= 0 {
        __big_set(mp, 1)
        __big_mulpow2(mp, e)
        __big_copy(mm, mp)
        if f != hidden {
            __big_set(r, f)
            __big_mulpow2(r, e)
            __big_mul(r, 2)
            __big_set(s, 2)
        } else {
            __big_set(r, f)
            __big_mulpow2(r, e + 1)
            __big_mul(r, 2)
            __big_set(s, 4)
            __big_mul(mp, 2)
        }
    } else {
        if ex <= 1 || f != hidden {
            __big_set(r, f)
            __big_mul(r, 2)
            __big_set(s, 1)
            __big_mulpow2(s, 1 - e)
            __big_set(mp, 1)
            __big_set(mm, 1)
        } else {
            __big_set(r, f)
            __big_mul(r, 4)
            __big_set(s, 1)
            __big_mulpow2(s, 2 - e)
            __big_set(mp, 2)
            __big_set(mm, 1)
        }
    }
    var kf = float64(e + mb) * 0.30102999566398114
    var k = int64(kf)
    if float64(k) > kf {
        k = k - 1
    }
    if k >= 0 {
        __big_mulpow10(s, k)
    } else {
        __big_mulpow10(r, 0 - k)
        __big_mulpow10(mp, 0 - k)
        __big_mulpow10(mm, 0 - k)
    }
    while true {
        __big_add(t1, r, mp)
        if !__bd_reach(t1, s, even) {
            break
        }
        __big_mul(s, 10)
        k = k + 1
    }
    while true {
        __big_add(t1, r, mp)
        __big_mul(t1, 10)
        if __bd_reach(t1, s, even) {
            break
        }
        __big_mul(r, 10)
        __big_mul(mp, 10)
        __big_mul(mm, 10)
        k = k - 1
    }
    var dg = stackbuf(32)
    var nd: int64 = 0
    while true {
        __big_mul(r, 10)
        __big_mul(mp, 10)
        __big_mul(mm, 10)
        var d: int64 = 0
        while __big_cmp(r, s) >= 0 {
            __big_sub(r, s)
            d = d + 1
        }
        var c1 = __big_cmp(r, mm)
        var low = c1 < 0
        if even {
            low = c1 <= 0
        }
        __big_add(t1, r, mp)
        var high = __bd_reach(t1, s, even)
        if !low && !high {
            dg[nd] = uint8(d)
            nd = nd + 1
        } else {
            if low && !high {
                dg[nd] = uint8(d)
            } else if !low && high {
                dg[nd] = uint8(d + 1)
            } else {
                // обидві цифри підходять: ближча до точного значення, при рівності - парна (як Python/C)
                __big_copy(t2, r)
                __big_mul(t2, 2)
                var c2 = __big_cmp(t2, s)
                if c2 < 0 || (c2 == 0 && d % 2 == 0) {
                    dg[nd] = uint8(d)
                } else {
                    dg[nd] = uint8(d + 1)
                }
            }
            nd = nd + 1
            break
        }
    }
    __nx_fmt_digits(dg, nd, k)
}

func __nx_print_f64(x: float64) {
    __nx_print_fp(float64Bits(x), 52, 11)
}

func __nx_print_f32(x: float32) {
    __nx_print_fp(int64(uint32(float32Bits(x))), 23, 8)
}

// ---------- пам'ять ----------
// Блоки розмірів 32, 64, ... 65536 байтів (12 класів) з 16-байтовим заголовком: [0] - клас (або
// мінус розмір для великих), [1] - наступний у списку вільних. Звільнений блок іде у список свого
// класу й видається знову (пам'ять не росте). Більше 64 КБ - окремий mmap/munmap.
// alloc завжди повертає нулі; realloc - як у C (нові байти не обнуляються).

var __nx_freelists: ptr<ptr<int64>> = null
var __nx_mapped: int64 = 0

func __nx_mmap(n: int64) -> ptr<uint8> {
    atomicAdd(addr(__nx_mapped), n)
    return asptr(syscall(9, 0, n, 3, 34, -1, 0))
}

func __nx_bump(n: int64) -> ptr<uint8> {
    if __nx_heap == null || __nx_heap + n > __nx_heap_end {
        var size: int64 = 4194304
        __nx_heap = __nx_mmap(size)
        __nx_heap_end = __nx_heap + size
    }
    var p = __nx_heap
    __nx_heap = __nx_heap + n
    return p
}

func __nx_alloc_u(n: int64) -> ptr<void> {
    if n < 0 {
        n = 0
    }
    var total = n + 16
    if total > 65536 {
        total = (total + 4095) & ~4095
        var big: ptr<int64> = asptr(__nx_mmap(total))
        big[0] = 0 - total
        return big + 2
    }
    var c: int64 = 0
    var size: int64 = 32
    while size < total {
        size = size * 2
        c = c + 1
    }
    if __nx_freelists == null {
        __nx_freelists = asptr(__nx_mmap(4096))
    }
    var b = __nx_freelists[c]
    if b != null {
        __nx_freelists[c] = asptr(b[1])
        memset(b + 2, 0, size - 16)
    } else {
        b = asptr(__nx_bump(size))
    }
    b[0] = c
    b[1] = 0
    return b + 2
}

func __nx_release_u(p: ptr<void>) {
    if p == null {
        return
    }
    var b: ptr<int64> = asptr(p)
    b = b - 2
    var c = b[0]
    if c < 0 {
        atomicAdd(addr(__nx_mapped), c)
        syscall(11, b, 0 - c)
        return
    }
    b[1] = int64(__nx_freelists[c])
    __nx_freelists[c] = b
}

// поки є лише головний потік - без замка (жодної ціни); після першого spawn - замок на futex
func __nx_alloc(n: int64) -> ptr<void> {
    if !__nx_threaded {
        return __nx_alloc_u(n)
    }
    __nx_lock(addr(__nx_heaplock))
    var p = __nx_alloc_u(n)
    __nx_unlock(addr(__nx_heaplock))
    return p
}

func __nx_release(p: ptr<void>) {
    if !__nx_threaded {
        __nx_release_u(p)
        return
    }
    __nx_lock(addr(__nx_heaplock))
    __nx_release_u(p)
    __nx_unlock(addr(__nx_heaplock))
}

func __nx_realloc(p: ptr<void>, n: int64) -> ptr<void> {
    if p == null {
        return __nx_alloc(n)
    }
    var b: ptr<int64> = asptr(p)
    b = b - 2
    var cap: int64 = 0
    if b[0] < 0 {
        cap = 0 - b[0] - 16
    } else {
        cap = (32 << b[0]) - 16
    }
    if n <= cap {
        return p
    }
    var q = __nx_alloc(n)
    memcpy(q, p, cap)
    __nx_release(p)
    return q
}

// ---------- потоки ----------
// Потік = clone зі спільною пам'яттю і своїм стеком (1 МБ, mmap). Кожен потік має блок TLS
// (4 КБ, на нього вказує fs): [0] - сам блок, [1] - ptr<Thread> (у головного - null), з 64-го
// байта - пам'ять для tls(). Очікування - futex (202): поки значення не змінилось, потік спить
// у ядрі, а не крутиться.

var __nx_threaded: bool = false
var __nx_heaplock: int32 = 0

// м'ютекс за Дреппером: 0 - вільний, 1 - зайнятий, 2 - зайнятий і хтось чекає
func __nx_lock(s: ptr<int32>) {
    var c = atomicCas(s, 0, 1)
    if c == 0 {
        return
    }
    if c != 2 {
        c = atomicSwap(s, 2)
    }
    while c != 0 {
        syscall(202, s, 128, 2, 0, 0, 0)
        c = atomicSwap(s, 2)
    }
}

func __nx_unlock(s: ptr<int32>) {
    if atomicAdd(s, -1) != 1 {
        atomicStore(s, 0)
        syscall(202, s, 129, 1, 0, 0, 0)
    }
}

struct Mutex {
    state: int32

    func Mutex.lock() {
        __nx_lock(addr(self.state))
    }

    func Mutex.unlock() {
        __nx_unlock(addr(self.state))
    }

    func Mutex.tryLock() -> bool {
        return atomicCas(addr(self.state), 0, 1) == 0
    }
}

// умовна змінна: лічильник подій; wait засинає, поки лічильник той самий
struct Cond {
    seq: int32

    func Cond.wait(m: ptr<Mutex>) {
        var q = addr(self.seq)
        var v = atomicLoad(q)
        m.unlock()
        syscall(202, q, 128, v, 0, 0, 0)
        var s = addr(m.state)
        while atomicSwap(s, 2) != 0 {
            syscall(202, s, 128, 2, 0, 0, 0)
        }
    }

    func Cond.signal() {
        atomicAdd(addr(self.seq), 1)
        syscall(202, addr(self.seq), 129, 1, 0, 0, 0)
    }

    func Cond.broadcast() {
        atomicAdd(addr(self.seq), 1)
        syscall(202, addr(self.seq), 129, 2147483647, 0, 0, 0)
    }
}

struct Thread {
    tid: int32
    fn: ptr<void>
    arg: ptr<void>
    result: int64
    stack: ptr<uint8>
    tlsBlock: ptr<int64>
}

func __nx_tls_new(t: ptr<Thread>) -> ptr<int64> {
    var b: ptr<int64> = asptr(__nx_mmap(4096))
    b[0] = int64(b)
    b[1] = int64(t)
    return b
}

func __nx_tls_init() {
    syscall(158, 4098, __nx_tls_new(asptr(0)))
}

func __nx_thread_entry(t: ptr<Thread>) {
    t.result = callptr(t.fn, t.arg)
}

// spawn(funcaddr(f), arg): f(arg) -> int64 у новому потоці; null - не вдалось
func spawn(f: ptr<void>, arg: ptr<void>) -> ptr<Thread> {
    __nx_threaded = true
    var t = new(Thread)
    t.fn = f
    t.arg = arg
    var size: int64 = 1048576
    t.stack = __nx_mmap(size)
    t.tlsBlock = __nx_tls_new(t)
    var top: ptr<int64> = asptr(t.stack + size - 16)
    top[0] = int64(t)
    // VM|FS|FILES|SIGHAND|THREAD|SYSVSEM|SETTLS|PARENT_SETTID|CHILD_CLEARTID
    var r = __nx_clone(4001536, top, addr(t.tid), addr(t.tid), t.tlsBlock)
    if r < 0 {
        syscall(11, t.stack, size)
        syscall(11, t.tlsBlock, 4096)
        free(t)
        return asptr(0)
    }
    return t
}

// дочекатися кінця потоку, звільнити його стек і повернути результат f
func join(t: ptr<Thread>) -> int64 {
    var q = addr(t.tid)
    var v = atomicLoad(q)
    while v != 0 {
        syscall(202, q, 0, v, 0, 0, 0)
        v = atomicLoad(q)
    }
    var r = t.result
    syscall(11, t.stack, 1048576)
    syscall(11, t.tlsBlock, 4096)
    atomicAdd(addr(__nx_mapped), 0 - 1048576 - 4096)
    free(t)
    return r
}

// номер потоку в ядрі (gettid)
func threadId() -> int64 {
    return syscall(186)
}

// ---------- рядки (нуль у кінці) ----------
func strLen(s: ptr<uint8>) -> int64 {
    var n: int64 = 0
    while s[n] != 0 {
        n = n + 1
    }
    return n
}

func strEq(a: ptr<uint8>, b: ptr<uint8>) -> bool {
    var i: int64 = 0
    while a[i] == b[i] {
        if a[i] == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

func strStarts(s: ptr<uint8>, prefix: ptr<uint8>) -> bool {
    var i: int64 = 0
    while prefix[i] != 0 {
        if s[i] != prefix[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// новий рядок a + b (alloc; звільняти free)
func strCat(a: ptr<uint8>, b: ptr<uint8>) -> ptr<uint8> {
    var na = strLen(a)
    var nb = strLen(b)
    var r: ptr<uint8> = asptr(alloc(na + nb + 1))
    memcpy(r, a, na)
    memcpy(r + na, b, nb + 1)
    return r
}

// шлях a/b (alloc)
func pathJoin(a: ptr<uint8>, b: ptr<uint8>) -> ptr<uint8> {
    var na = strLen(a)
    var nb = strLen(b)
    var r: ptr<uint8> = asptr(alloc(na + nb + 2))
    memcpy(r, a, na)
    r[na] = 47
    memcpy(r + na + 1, b, nb + 1)
    return r
}

// ціле десятково в buf (від 21 байта), повертає довжину; нуль у кінці
func fmtInt(buf: ptr<uint8>, v: int64) -> int64 {
    var tmp = stackbuf(32)
    var i: int64 = 0
    var neg = v < 0
    var u = uint64(v)
    if neg {
        u = uint64(0) - u
    }
    while true {
        tmp[i] = uint8(48 + int64(u % 10))
        i = i + 1
        u = u / 10
        if u == 0 {
            break
        }
    }
    var n: int64 = 0
    if neg {
        buf[0] = 45
        n = 1
    }
    while i > 0 {
        i = i - 1
        buf[n] = tmp[i]
        n = n + 1
    }
    buf[n] = 0
    return n
}

// десяткове ціле з рядка (без перевірок; зупиняється на першому не-цифровому)
func parseInt(s: ptr<uint8>) -> int64 {
    var i: int64 = 0
    var neg = false
    if s[0] == 45 {
        neg = true
        i = 1
    }
    var v: int64 = 0
    while s[i] >= 48 && s[i] <= 57 {
        v = v * 10 + int64(s[i]) - 48
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

// ---------- аргументи й оточення ----------
var __nx_args: ptr<int64> = null

func argCount() -> int64 {
    return __nx_args[0]
}

// аргумент i (0 - сама програма); null, якщо нема
func arg(i: int64) -> ptr<uint8> {
    if i < 0 || i >= __nx_args[0] {
        return asptr(0)
    }
    return asptr(__nx_args[1 + i])
}

// значення змінної оточення або null
func envGet(name: ptr<uint8>) -> ptr<uint8> {
    var e = __nx_args + 2 + __nx_args[0]
    var n = strLen(name)
    while e[0] != 0 {
        var s: ptr<uint8> = asptr(e[0])
        if strStarts(s, name) && s[n] == 61 {
            return s + n + 1
        }
        e = e + 1
    }
    return asptr(0)
}

// ---------- файли ----------
// Усі функції повертають від'ємне число (-errno) при помилці: -2 нема файлу, -13 нема доступу, -17 вже є.

func fileOpen(path: ptr<uint8>) -> int64 {
    return syscall(2, path, 524288, 0)
}

// створити/перезаписати файл для запису (права 644)
func fileCreate(path: ptr<uint8>) -> int64 {
    return syscall(2, path, 524288 | 1 | 64 | 512, 420)
}

// дописувати в кінець (створить, якщо нема)
func fileAppend(path: ptr<uint8>) -> int64 {
    return syscall(2, path, 524288 | 1 | 64 | 1024, 420)
}

func fdRead(fd: int64, buf: ptr<void>, n: int64) -> int64 {
    return syscall(0, fd, buf, n)
}

// записати все (повторює, поки не запише n байтів); повертає n або -errno
func fdWrite(fd: int64, buf: ptr<void>, n: int64) -> int64 {
    var p: ptr<uint8> = asptr(buf)
    var done: int64 = 0
    while done < n {
        var r = syscall(1, fd, p + done, n - done)
        if r == -4 {
            continue
        }
        if r < 0 {
            return r
        }
        done = done + r
    }
    return n
}

func fdWriteStr(fd: int64, s: ptr<uint8>) -> int64 {
    return fdWrite(fd, s, strLen(s))
}

func fdClose(fd: int64) -> int64 {
    return syscall(3, fd)
}

// перейти на позицію (whence: 0 від початку, 1 від поточної, 2 від кінця)
func fdSeek(fd: int64, off: int64, whence: int64) -> int64 {
    return syscall(8, fd, off, whence)
}

// stat: розмір і тип; -errno, якщо нема
struct FileInfo {
    size: int64
    mode: uint32
    mtime: int64
    isDir: bool
    isFile: bool
}

func fileInfo(path: ptr<uint8>, out: ptr<FileInfo>) -> int64 {
    var st: ptr<uint8> = stackbuf(144)
    var r = syscall(4, path, st)
    if r < 0 {
        return r
    }
    var m: ptr<uint32> = asptr(st + 24)
    var sz: ptr<int64> = asptr(st + 48)
    var mt: ptr<int64> = asptr(st + 88)
    out.size = sz[0]
    out.mode = m[0]
    out.mtime = mt[0]
    out.isDir = (m[0] & 61440) == 16384
    out.isFile = (m[0] & 61440) == 32768
    return 0
}

// розмір файлу або -errno
func fileSize(path: ptr<uint8>) -> int64 {
    var fi: FileInfo
    var r = fileInfo(path, fi)
    if r < 0 {
        return r
    }
    return fi.size
}

func pathExists(path: ptr<uint8>) -> bool {
    var fi: FileInfo
    return fileInfo(path, fi) == 0
}

func isDir(path: ptr<uint8>) -> bool {
    var fi: FileInfo
    return fileInfo(path, fi) == 0 && fi.isDir
}

func makeDir(path: ptr<uint8>) -> int64 {
    return syscall(83, path, 493)
}

func removeFile(path: ptr<uint8>) -> int64 {
    return syscall(87, path)
}

func removeDir(path: ptr<uint8>) -> int64 {
    return syscall(84, path)
}

func renamePath(from: ptr<uint8>, to: ptr<uint8>) -> int64 {
    return syscall(82, from, to)
}

// увесь файл у пам'ять (alloc, нуль у кінці); довжина - у *len; null при помилці
func fileReadAll(path: ptr<uint8>, len: ptr<int64>) -> ptr<uint8> {
    var fd = fileOpen(path)
    if fd < 0 {
        return asptr(0)
    }
    var cap: int64 = 4096
    var n: int64 = 0
    var buf: ptr<uint8> = asptr(alloc(cap + 1))
    while true {
        if n == cap {
            cap = cap * 2
            buf = asptr(realloc(buf, cap + 1))
        }
        var r = fdRead(fd, buf + n, cap - n)
        if r == -4 {
            continue
        }
        if r < 0 {
            fdClose(fd)
            free(buf)
            return asptr(0)
        }
        if r == 0 {
            break
        }
        n = n + r
    }
    fdClose(fd)
    buf[n] = 0
    if len != null {
        len[0] = n
    }
    return buf
}

func fileWriteAll(path: ptr<uint8>, data: ptr<void>, n: int64) -> int64 {
    var fd = fileCreate(path)
    if fd < 0 {
        return fd
    }
    var r = fdWrite(fd, data, n)
    fdClose(fd)
    return r
}

// копіювати файл блоками по 64 КБ; 0 або -errno
func copyFile(from: ptr<uint8>, to: ptr<uint8>) -> int64 {
    var src = fileOpen(from)
    if src < 0 {
        return src
    }
    var dst = fileCreate(to)
    if dst < 0 {
        fdClose(src)
        return dst
    }
    var buf = alloc(65536)
    var res: int64 = 0
    while true {
        var r = fdRead(src, buf, 65536)
        if r == -4 {
            continue
        }
        if r <= 0 {
            res = r
            break
        }
        var w = fdWrite(dst, buf, r)
        if w < 0 {
            res = w
            break
        }
    }
    free(buf)
    fdClose(src)
    fdClose(dst)
    return res
}

// ---------- теки ----------
// var d = dirOpen("шлях"); while (name = d.next()) != null {...}; d.close()
// next() пропускає "." і ".."; ім'я дійсне до наступного next().
struct Dir {
    fd: int64
    buf: ptr<uint8>
    pos: int64
    len: int64
    lastType: uint8

    func Dir.next() -> ptr<uint8> {
        while true {
            if self.pos >= self.len {
                var r = syscall(217, self.fd, self.buf, 32768)
                if r <= 0 {
                    return asptr(0)
                }
                self.len = r
                self.pos = 0
            }
            var e = self.buf + self.pos
            var reclen: ptr<uint16> = asptr(e + 16)
            self.pos = self.pos + int64(reclen[0])
            self.lastType = e[18]
            var name = e + 19
            if !(name[0] == 46 && (name[1] == 0 || (name[1] == 46 && name[2] == 0))) {
                return name
            }
        }
        return asptr(0)
    }

    // тип останнього запису з next(): тека?
    func Dir.lastIsDir() -> bool {
        return self.lastType == 4
    }

    func Dir.close() {
        fdClose(self.fd)
        free(self.buf)
        free(self)
    }
}

// null, якщо теки нема
func dirOpen(path: ptr<uint8>) -> ptr<Dir> {
    var fd = syscall(2, path, 524288 | 65536, 0)
    if fd < 0 {
        return asptr(0)
    }
    var d = new(Dir)
    d.fd = fd
    d.buf = asptr(alloc(32768))
    return d
}

// скопіювати теку з усім вмістом; 0 або -errno
func copyTree(from: ptr<uint8>, to: ptr<uint8>) -> int64 {
    var d = dirOpen(from)
    if d == null {
        return -2
    }
    var mk = makeDir(to)
    if mk < 0 && mk != -17 {
        d.close()
        return mk
    }
    var res: int64 = 0
    var name = d.next()
    while name != null && res == 0 {
        var s = pathJoin(from, name)
        var t = pathJoin(to, name)
        if d.lastIsDir() {
            res = copyTree(s, t)
        } else {
            res = copyFile(s, t)
        }
        free(s)
        free(t)
        name = d.next()
    }
    d.close()
    return res
}

// ---------- час ----------
// наносекунди з 1970 (реальний годинник)
func nowNanos() -> int64 {
    var ts: ptr<int64> = asptr(stackbuf(16))
    syscall(228, 0, ts)
    return ts[0] * 1000000000 + ts[1]
}

// наносекунди монотонного годинника (для вимірювань; не стрибає при зміні часу)
func monoNanos() -> int64 {
    var ts: ptr<int64> = asptr(stackbuf(16))
    syscall(228, 1, ts)
    return ts[0] * 1000000000 + ts[1]
}

func sleepMs(ms: int64) {
    var ts: ptr<int64> = asptr(stackbuf(16))
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    while syscall(35, ts, ts) == -4 {
    }
}

func pid() -> int64 {
    return syscall(39)
}

func exit(code: int64) {
    syscall(231, code)
}

// ---------- мережа (TCP, IPv4) ----------
func __nx_sockaddr(b: ptr<uint8>, ip: uint32, port: int64) {
    memset(b, 0, 16)
    b[0] = 2
    b[2] = uint8(port >> 8)
    b[3] = uint8(port & 255)
    b[4] = uint8(ip >> 24)
    b[5] = uint8((ip >> 16) & 255)
    b[6] = uint8((ip >> 8) & 255)
    b[7] = uint8(ip & 255)
}

// адреса a.b.c.d як число: ipv4(127, 0, 0, 1)
func ipv4(a: int64, b: int64, c: int64, d: int64) -> uint32 {
    return uint32((a << 24) | (b << 16) | (c << 8) | d)
}

// слухати порт (0 - будь-який вільний, дізнатись - sockPort); fd або -errno
func tcpListen(ip: uint32, port: int64) -> int64 {
    var fd = syscall(41, 2, 1 | 524288, 0)
    if fd < 0 {
        return fd
    }
    var one: int32 = 1
    syscall(54, fd, 1, 2, addr(one), 4)
    var sa = stackbuf(16)
    __nx_sockaddr(sa, ip, port)
    var r = syscall(49, fd, sa, 16)
    if r == 0 {
        r = syscall(50, fd, 128)
    }
    if r < 0 {
        fdClose(fd)
        return r
    }
    return fd
}

// порт, на якому сокет (після tcpListen з портом 0)
func sockPort(fd: int64) -> int64 {
    var sa = stackbuf(16)
    var len: int32 = 16
    if syscall(51, fd, sa, addr(len)) < 0 {
        return -1
    }
    return (int64(sa[2]) << 8) | int64(sa[3])
}

func tcpAccept(fd: int64) -> int64 {
    while true {
        var c = syscall(288, fd, 0, 0, 524288)
        if c != -4 {
            return c
        }
    }
    return -1
}

func tcpConnect(ip: uint32, port: int64) -> int64 {
    var fd = syscall(41, 2, 1 | 524288, 0)
    if fd < 0 {
        return fd
    }
    var sa = stackbuf(16)
    __nx_sockaddr(sa, ip, port)
    var r = syscall(42, fd, sa, 16)
    if r < 0 {
        fdClose(fd)
        return r
    }
    return fd
}

// чекати, поки в fd з'являться дані (або з'єднання для слухача); false - минув час (ms; -1 - без кінця)
func pollIn(fd: int64, ms: int64) -> bool {
    var p = stackbuf(8)
    var pfd: ptr<int32> = asptr(p)
    pfd[0] = int32(fd)
    var ev: ptr<int16> = asptr(p + 4)
    ev[0] = 1
    ev[1] = 0
    var r = syscall(7, p, 1, ms)
    return r > 0
}
