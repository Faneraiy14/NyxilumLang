<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Мова сама (лексер/парсер/компілятор/VM, майже вся стандартна
      бібліотека) кросплатформна. GUI (guiWindow тощо) і 2D/3D-графіка
      (createCanvas тощо) сидять на Windows Forms, який поза Windows не
      працює — тому другий таргет net10.0-windows, а не єдиний.
      На Linux/Mac (net10.0) ці функції просто не реєструються — скрипт,
      який їх не використовує, працює однаково скрізь.
    -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <!-- AssemblyName окремо від назви csproj/проєкту: сам мовний проєкт —
         NyxilumLang, але CLI-бінарник, який з нього збирається, — "nx"
         (коротка команда), тому файл на диску Nx(.exe), а не
         NyxilumLang(.exe). -->
    <AssemblyName>Nx</AssemblyName>
    <!-- Значення тут - лише дефолт для локальної збірки (звичайний
         dotnet build чи dotnet run без прапорців). Реальний реліз
         (NyxilumNode/.github/workflows/release.yml) підставляє версію з
         git-тегу автоматично через dotnet publish з прапорцем Version,
         тому цей рядок більше НЕ треба вручну синхронізувати з тегом -
         раніше про це забували, і команда version у зібраному nx
         місяцями показувала застарілу версію. Тримаємо орієнтовно
         актуальним про людське око, критичності немає. -->
    <Version>1.4.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWindowsForms>
    <DefineConstants Condition="'$(TargetFramework)' == 'net10.0-windows'">$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Сестринський проєкт (окремий репозиторій) — embedded KV-база
         з WAL, підключена як стандартна бібліотека db*-функцій
         (dbOpen/dbGet/dbSet/...). -->
    <ProjectReference Include="..\..\..\NyxilumDb\src\NyxilumDb\NyxilumDb.csproj" />
  </ItemGroup>
</Project>